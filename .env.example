# Copy to .env (git-ignored). NEVER commit real keys.
# Alpaca PAPER keys only. Rotate any key that has been pasted into chat or screenshots.
ALPACA_ENV=paper
ALPACA_PAPER_API_KEY=your_paper_key_id
ALPACA_PAPER_API_SECRET=your_paper_secret
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
